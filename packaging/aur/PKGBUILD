# Maintainer: Chace Berry <chaceberry686@gmail.com>
pkgname=alterion-open-project
pkgver=1.0.4
pkgrel=1
pkgdesc="Project scheduler with a critical path engine, Gantt chart and Microsoft Project import"
arch=('x86_64' 'aarch64')
url="https://gitlab.com/alterion-software/alterion-open-project"
license=('Apache-2.0')
depends=('gtk3' 'webkit2gtk-4.1' 'xdotool' 'gcc-libs' 'glibc')
makedepends=('cargo' 'pkgconf')
options=('!lto')

# An Arch pkgver may not contain a hyphen, so the pre-release suffix is dropped
# here and put back when building the upstream tag. Cargo.toml says
# 0.1.0-beta, this says 0.1.0, and the tag below reunites them.
_tag="v${pkgver}-beta"
source=("$pkgname-$pkgver.tar.gz::$url/-/archive/$_tag/$pkgname-$_tag.tar.gz")
sha256sums=('3083336c44e568747f73ba4c59d1c16a03242cc9607bb71e2b2733f2dee3f205')

prepare() {
  cd "$pkgname-$_tag"
  export RUSTUP_TOOLCHAIN=stable

  # Removed --locked so Cargo can generate/update the lockfile
  cargo fetch --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$_tag"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target

  # Removed --frozen
  cargo build --release --package aop-app
}

check() {
  cd "$pkgname-$_tag"
  export RUSTUP_TOOLCHAIN=stable

  # Removed --frozen
  cargo test --release
}

package() {
  cd "$pkgname-$_tag"

  install -Dm0755 target/release/alterion-open-project "$pkgdir/usr/bin/$pkgname"

  install -Dm0644 "packaging/linux/$pkgname.desktop" \
    "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm0644 "packaging/linux/$pkgname.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm0644 "packaging/linux/$pkgname.xml" \
    "$pkgdir/usr/share/mime/packages/$pkgname.xml"

  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
