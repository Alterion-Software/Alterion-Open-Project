<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-alterion-project">
    <comment>Alterion Project</comment>
    <glob pattern="*.aprj"/>
    <!-- Every .aprj begins with the four byte APRJ container magic. -->
    <magic priority="60">
      <match type="string" value="APRJ" offset="0"/>
    </magic>
    <!-- No icon element: the desktop looks for an icon named after the type
         itself, `application-x-alterion-project`, which install.sh places
         when the document artwork exists. Naming the application's icon here
         is what made a plan in a folder look like a second copy of the
         application. -->
  </mime-type>
</mime-info>
